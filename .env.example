# LLM_MODEL
# https://api.deepinfra.com/v1/openai openai/gpt-oss-20b
BASE_URL=https://api.deepinfra.com/v1/openai
MODEL=XiaomiMiMo/MiMo-V2.5
API_KEY=your_api_key
TEMPERATURE=0.7
MAX_TOKENS=262144
TIMEOUT=90
MAX_RETRIES=3

# SUPABASE
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
VITE_SUPABASE_REDIRECT_TO=http://localhost:3000/auth-test.html

# Stripe Checkout browser endpoints. Implement these routes on your backend.
VITE_STRIPE_CHECKOUT_SESSION_URL=/api/payments/stripe/checkout-sessions
VITE_STRIPE_CHECKOUT_STATUS_URL=/api/payments/stripe/checkout-sessions/{CHECKOUT_SESSION_ID}

